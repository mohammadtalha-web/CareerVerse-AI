DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=careerverse_ai
# Per Node.js process. Keep aggregate pool size within the database connection limit.
DB_POOL_SIZE=10

# Optional Google OpenID Connect sign-in. Register this exact callback URI
# as an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# SMTP for email/password account verification. For Brevo SMTP, use
# smtp-relay.brevo.com, port 587, SMTP_SECURE=false, your SMTP login/key,
# and a verified sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Persistent private storage for networking attachments (outside /public).
CAREERVERSE_UPLOAD_DIR=./var/uploads

# Local Ollama model for career tools, job matching, and consented resume
# screening. Install Ollama and pull the model (`ollama pull qwen2.5:3b`).
OLLAMA_MODEL=qwen2.5:3b

# Job source sync. Use exact feed hostnames; no sources are enabled by default.
JOB_SOURCE_SYNC_SECRET=
JOB_SOURCE_ALLOWED_HOSTS=
JOB_SOURCE_FEEDS_JSON=[]
# Optional source feed credentials are server-only:
# JOB_SOURCE_EXAMPLE_UK_API_KEY=

# Optional browser push. Generate once with `npx web-push generate-vapid-keys`.
# Keep the private key server-only; the public key is shared with the signed-in browser.
CAREERVERSE_VAPID_PUBLIC_KEY=
CAREERVERSE_VAPID_PRIVATE_KEY=
CAREERVERSE_VAPID_SUBJECT=mailto:admin@example.com